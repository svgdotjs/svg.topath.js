{
  "name": "@svgdotjs/svg.topath.js",
  "version": "3.0.0",
  "description": "An extension for svg.js to convert shapes to paths",
  "type": "module",
  "main": "dist/svg.topath.js",
  "module": "src/svg.topath.js",
  "exports": {
    ".": {
      "import": {
        "types": "./svg.topath.js.d.ts",
        "default": "./src/svg.topath.js"
      },
      "require": {
        "types": "./svg.topath.js.d.cts",
        "default": "./src/svg.topath.js"
      },
      "browser": {
        "types": "./svg.topath.js.d.ts",
        "default": "./src/svg.topath.js"
      }
    }
  },
  "unpkg": "dist/svg.topath.js",
  "jsdelivr": "dist/svg.topath.js",
  "files": [
    "/dist",
    "/src",
    "/svg.topath.js.d.ts",
    "/svg.topath.js.d.cts"
  ],
  "keywords": [
    "svg.js"
  ],
  "bugs": "https://github.com/svgdotjs/svg.topath.js/issues",
  "license": "MIT",
  "typings": "./svg.topath.js.d.ts",
  "author": {
    "name": "Wout Fierens"
  },
  "contributors": [
    {
      "name": "Wout Fierens"
    },
    {
      "name": "Ulrich-Matthias Schäfer"
    }
  ],
  "homepage": "https://github.com/svgdotjs/svg.topath.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgdotjs/svg.topath.js.git"
  },
  "scripts": {
    "build": "npm run fix && vite build",
    "fix": "npx eslint --fix",
    "lint": "npx eslint ./src spec/*.mjs",
    "prepublishOnly": "rm -rf ./dist && npm run build",
    "test": "node --test \"spec/*.test.mjs\""
  },
  "devDependencies": {
    "eslint": "^8.36.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.5",
    "typescript": "^5.0.2",
    "vite": "^4.2.1",
    "svgdom": "^0.1.29"
  },
  "peerDependencies": {
    "@svgdotjs/svg.js": "^3.2.4"
  }
}